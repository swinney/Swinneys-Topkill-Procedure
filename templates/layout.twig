<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ title|default('Swinney.org') }}{% endblock %}</title>
    <style>
        body {
            font-family: Verdana, Geneva, Arial, Helvetica, sans-serif;
            font-size: 10pt;
            background-color: #333333;
            color: #cccccc;
            margin: 0;
            padding: 0;
        }
        a { color: #ff9900; text-decoration: none; }
        a:hover { text-decoration: underline; }
        table.main { width: 100%; border-collapse: collapse; }
        td.header {
            background-color: #000000;
            color: #ffffff;
            padding: 10px;
            font-size: 14pt;
            font-weight: bold;
        }
        td.nav {
            background-color: #444444;
            padding: 5px 10px;
            font-size: 9pt;
        }
        td.sidebar {
            background-color: #2a2a2a;
            width: 150px;
            padding: 10px;
            vertical-align: top;
            font-size: 9pt;
        }
        td.content {
            padding: 15px;
            vertical-align: top;
        }
        td.footer {
            background-color: #000000;
            color: #888888;
            padding: 10px;
            font-size: 8pt;
            text-align: center;
        }
        .section-header {
            color: #ff9900;
            font-weight: bold;
            font-size: 11pt;
            margin-bottom: 5px;
        }
    </style>
    {% block head %}{% endblock %}
</head>
<body>
<table class="main" cellpadding="0" cellspacing="0">
    {# Header #}
    <tr>
        <td class="header" colspan="2">
            {% block header %}
            <a href="/" style="color: #ffffff; text-decoration: none;">swinney.org</a>
            {% endblock %}
        </td>
    </tr>

    {# Navigation #}
    <tr>
        <td class="nav" colspan="2">
            {% block nav %}
            <a href="/">home</a> |
            <a href="/search">search</a> |
            <a href="/rollcall">roll call</a> |
            <a href="/submit">submit</a> |
            <a href="/login">login</a> |
            <a href="/register">register</a>
            {% endblock %}
        </td>
    </tr>

    {# Main content area with sidebar #}
    <tr>
        <td class="sidebar">
            {% block sidebar %}
            <div class="section-header">Roll Call</div>
            <p><em>Coming soon...</em></p>
            {% endblock %}
        </td>
        <td class="content">
            {% block content %}{% endblock %}
        </td>
    </tr>

    {# Footer #}
    <tr>
        <td class="footer" colspan="2">
            {% block footer %}
            &copy; swinney.org | night of the living dead but for 90s websites
            {% endblock %}
        </td>
    </tr>
</table>
</body>
</html>
