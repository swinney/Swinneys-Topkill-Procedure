{
    "name": "swinney/topkill",
    "description": "Swinney.org — resurrected article/comment publishing platform",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "slim/slim": "^4.0",
        "slim/psr7": "^1.0",
        "slim/csrf": "^1.0",
        "slim/flash": "^0.4",
        "php-di/php-di": "^7.0",
        "php-di/slim-bridge": "^3.0",
        "twig/twig": "^3.0",
        "vlucas/phpdotenv": "^5.0",
        "robmorgan/phinx": "^0.16"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Swinsite\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Swinsite\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
