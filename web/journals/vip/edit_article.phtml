  $query="SELECT articles_info.web,
                 articles_info.title,
                 articles_info.blurb,
                 articles_info.keywords,
                 articles_info.category,
                 articles_text.text,
                 articles_info.article_id,
                 articles_info.status
            FROM articles_info, 
                 articles_text 
           WHERE username='$_SESSION['authenticated_username']' 
             AND articles_info.article_id=articles_text.article_id 
        ORDER BY articles_info.article_id DESC
           LIMIT 1";
  $res=$db->query($query);
  if (DB::isError($res)) { die(error_page($res->getMessage())); }
  $row = $res->fetchRow();
  if ($row) {
    $web          =stripslashes($row[0]);
    $temp_title   =stripslashes($row[1]);
    $blurb        =stripslashes($row[2]);
    $keywords     =stripslashes($row[3]);
    $category     =             $row[4];
    $text         =stripslashes($row[5]);
    $temp_aid     =             $row[6];
    $status       =             pretty_status($row[7]);
    // register this temp_aid to keep it from messing up the usual
    // var article_id.
    $_SESSION['temp_aid'] = $temp_aid;
  }   
} else {
